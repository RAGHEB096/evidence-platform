# Edge Function secrets. Locally: copy to supabase/functions/.env (git-ignored),
# loaded by `npx supabase start`. Hosted: `npx supabase secrets set --env-file <file>`.
# Names may not start with SUPABASE_ (reserved for the values Supabase injects).

# One-time token for /setup (ADR-002). At least 24 characters; generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Delete this secret once the first administrator exists.
SETUP_TOKEN=replace-with-a-long-random-value

# Must equal VITE_AUTH_EMAIL_DOMAIN in the web app's environment.
AUTH_EMAIL_DOMAIN=users.evidence-platform.local

# Browser origins allowed to call the functions, comma-separated.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
