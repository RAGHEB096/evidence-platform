# Copy to .env.local and fill in. Every VITE_ variable is shipped to the
# browser, so none of them may hold a secret.

# Local: printed by `npx supabase status` (API URL). Hosted: Project Settings → API.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# The publishable key (sb_publishable_...). Never the secret key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Domain used for the synthetic Auth emails behind usernames (ADR-001). Not a secret.
VITE_AUTH_EMAIL_DOMAIN=users.evidence-platform.local
